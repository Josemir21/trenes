# dfa_cli_compacto.py — versión reducida
import sys, matplotlib.pyplot as plt, networkx as nx
from matplotlib.patches import FancyArrowPatch
from matplotlib.path import Path

# === Definición del DFA ===
states = {"q0","q1","q2","q3","q4","q5","q6","q7","q8","q9","q9b","q10","q11"}
alphabet = {"a","b"}
delta = {("q0","a"):{"q1"},
        ("q1","a"):{"q2"},
        ("q1","b"):{"q3"},
        ("q2","a"):{"q2","q3","q4"},
        ("q3","b"):{"q2","q3","q4"},
        ("q4","a"):{"q5"},
        ("q4","b"):{"q6"},
        ("q5","a"):{"q9"},
        ("q6","a"):{"q7"},
        ("q7","a"):{"q7","q9"},
        ("q7","b"):{"q8"},
        ("q8","a"):{"q9b"},
        ("q9b","a"):{"q9"},
        ("q9","a"):{"q10"},
        ("q10","a"):{"q11"}}

q0, F = "q0", {"q11"}

# === Simulación ===
def run(s):
    q, steps = {q0}, [{q0}]
    for i,ch in enumerate(s):
        q = set().union(*(delta.get((x,ch),set()) for x in q))
        if not q: raise ValueError(f"Sin transición con '{ch}' en pos {i}")
        steps.append(q)
    return steps, bool(steps[-1] & F)

# === Grafo y layout ===
G = nx.MultiDiGraph(); G.add_nodes_from(states)
for (q,a),ps in delta.items():
    for p in ps: G.add_edge(q,p,key=a,label=a)
pos = {"q0":(0,2),"q1":(1.6,2),"q2":(3.2,3.4),"q3":(3.2,0.9),"q4":(5,2),"q5":(4.6,-0.4),
       "q6":(9,2),"q7":(9,-0.4),"q8":(8,-1.8),"q9b":(6.5,-1.8),"q9":(4.8,-1.8),
       "q10":(3.2,-1.8),"q11":(1.6,-1.8)}

# === Dibujo por paso ===
def _mid(p1,p2,o=0.10):
    (x1,y1),(x2,y2)=p1,p2; mx,my=(x1+x2)/2,(y1+y2)/2; dx,dy=x2-x1,y2-y1; nx_,ny_=-dy,dx; L=(nx_**2+ny_**2)**0.5 or 1
    return mx+o*nx_/L, my+o*ny_/L

def draw_step(current, idx, sym=None):
    plt.clf(); nodes=list(G.nodes())
    nx.draw_networkx_nodes(G,pos,nodelist=nodes,node_size=[1500 if n in current else 1100 for n in nodes],node_color="white",linewidths=[3 if n in F else 1 for n in nodes],edgecolors="black")
    nx.draw_networkx_labels(G,pos,font_size=9)
    seen={}
    for u,v,k,d in G.edges(keys=True,data=True):
        if u==v:
            x,y=pos[u]; dx,dy={"q2":(0,1),"q3":(0,-1),"q7":(1,0)}.get(u,(0,1)); px,py=-dy,dx
            P=lambda a,b:(x+dx*a+px*b,y+dy*a+py*b)
            plt.gca().add_patch(FancyArrowPatch(path=Path([P(.2,-.1),P(.75,-.3),P(.75,.3),P(.2,.1)],[Path.MOVETO]+[Path.CURVE4]*3),arrowstyle='-|>',mutation_scale=18))
            plt.text(*P(.75,0),d['label'],fontsize=11,ha='center',va='center'); continue
        i=seen.get((u,v),0); seen[(u,v)]=i+1; rad=0.25 if G.has_edge(v,u) else 0.0
        nx.draw_networkx_edges(G,pos,edgelist=[(u,v)],node_size=1100,connectionstyle=f"arc3,rad={rad}",arrows=True,arrowstyle='-|>',arrowsize=20)
        lx,ly=_mid(pos[u],pos[v],0.10 if rad else 0.18); plt.text(lx,ly,d['label'],fontsize=11,ha='center',va='center')
    plt.axis('off'); plt.title(f"Paso {idx}: {', '.join(sorted(current))}" + (f" | '{sym}'" if sym else "")); plt.pause(1.0)

# === core/main ===
if __name__=='__main__':
    s = sys.argv[1] if len(sys.argv)>1 else input("Cadena (a/b): ").strip()
    try:
        steps, ok = run(s); print("ACEPTA" if ok else "RECHAZA", f"(estado final: {', '.join(sorted(steps[-1]))})")
        plt.ion(); draw_step(steps[0],0)
        for i,ch in enumerate(s,1): draw_step(steps[i],i,ch)
        plt.ioff(); plt.show()
    except Exception as e:
        print("RECHAZA:", e)
